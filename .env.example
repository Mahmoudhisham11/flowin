# Copy these to Vercel > Project > Settings > Environment Variables (Production AND Preview),
# or to .env.local for local development. Never commit real values.

# --- Firebase Admin (server) -------------------------------------------------
# Firebase console > Project settings > Service accounts > Generate new private key.
# Mark FIREBASE_PRIVATE_KEY as "Sensitive" in Vercel. Paste the key as is (the \n sequences are handled).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Push notifications (web) ------------------------------------------------
# Firebase console > Project settings > Cloud Messaging > Web Push certificates (key pair).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- AI (money manager chat, voice parsing, insights) -------------------------
# https://openrouter.ai/keys  (the app uses the free router model "openrouter/free").
OPENROUTER_API_KEY=

# --- Optional ----------------------------------------------------------------
# Public URL of the app (sent to OpenRouter as the HTTP referer), e.g. https://flowin-alpha.vercel.app
NEXT_PUBLIC_APP_URL=
# Shown on the privacy policy and terms pages.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Pro price in EGP charged on upgrade requests (default 99.99, see lib/plans.js).
PRO_PRICE_EGP=
# AI chat messages per user per day (default 40, admins are unlimited).
AI_CHAT_DAILY_LIMIT=
